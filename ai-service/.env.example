# DeepSeek OpenAI-compatible API root.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Existing Spring Boot service.
JAVA_API_BASE_URL=http://127.0.0.1:8080
JAVA_API_TIMEOUT_SECONDS=5

# Service settings.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pending appointment/cancellation confirmation lifetime.
CONFIRMATION_TTL_MINUTES=5

# Hospital knowledge base (RAG). Markdown files live in ai-service/knowledge.
RAG_ENABLED=true
KNOWLEDGE_DIR=
RAG_TOP_K=4
RAG_CHUNK_SIZE=480
RAG_CHUNK_OVERLAP=80

# Optional OpenAI-compatible embeddings endpoint. Leave RAG_EMBEDDING_MODEL
# empty to use built-in keyword retrieval (works without an embeddings API).
# When set, RAG_EMBEDDING_BASE_URL and RAG_EMBEDDING_API_KEY fall back to the
# LLM_* values above if left empty.
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_TIMEOUT_SECONDS=15
