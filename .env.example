# 复制本文件为同目录下的 .env 后填写本机配置。
# .env 已被 .gitignore 忽略，不会提交到仓库。
# 也可以直接设置同名系统环境变量，优先级高于 .env。

# ---- MySQL ----
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis（默认本地 127.0.0.1:6379，无密码可留空）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- JWT 签名密钥 ----
# 至少 32 位随机字符串，可用 openssl rand -base64 36 生成
JWT_SECRET=
